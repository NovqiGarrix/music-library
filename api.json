{
    "openapi": "3.0.0",
    "info": {
        "title": "Music Library API",
        "description": "API for managing and streaming music from YouTube sources",
        "version": "1.0.0"
    },
    "paths": {
        "/api/v1/musics": {
            "get": {
                "tags": [
                    "Music"
                ],
                "summary": "Get music tracks",
                "description": "Retrieve a paginated list of music tracks with optional search and field selection",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Page number for pagination (default: 1)",
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "default": 1
                        }
                    },
                    {
                        "name": "limit",
                        "in": "query",
                        "description": "Number of items per page (default: 20)",
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "default": 20
                        }
                    },
                    {
                        "name": "search",
                        "in": "query",
                        "description": "Search keyword to filter results",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "fields",
                        "in": "query",
                        "description": "Comma-separated list of fields to include in the response",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "List of music tracks",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "OK"
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/Track"
                                            }
                                        },
                                        "pagination": {
                                            "type": "object",
                                            "properties": {
                                                "currentPage": {
                                                    "type": "integer",
                                                    "example": 1
                                                },
                                                "pageSize": {
                                                    "type": "integer",
                                                    "example": 10
                                                },
                                                "totalItems": {
                                                    "type": "integer",
                                                    "example": 209
                                                },
                                                "totalPages": {
                                                    "type": "integer",
                                                    "example": 21
                                                },
                                                "nextPage": {
                                                    "type": "integer",
                                                    "example": 2,
                                                    "description": "The next page number, or null if this is the last page"
                                                }
                                            },
                                            "required": [
                                                "currentPage",
                                                "pageSize",
                                                "totalItems",
                                                "totalPages"
                                            ]
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid request parameters",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/musics/tracks_by_video": {
            "post": {
                "tags": [
                    "Music"
                ],
                "summary": "Create track from YouTube video",
                "description": "Download and store a track from a YouTube video URL or ID",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "url": {
                                        "type": "string",
                                        "description": "YouTube video URL or ID"
                                    }
                                },
                                "required": [
                                    "url"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Track created successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Track created successfully"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid request",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string",
                                            "example": "Invalid URL or video id."
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/musics/tracks_by_channel_handle": {
            "post": {
                "tags": [
                    "Music"
                ],
                "summary": "Create tracks from YouTube channel",
                "description": "Download and store tracks from a YouTube channel by handle",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "channelHandle": {
                                        "type": "string",
                                        "description": "YouTube channel handle"
                                    }
                                },
                                "required": [
                                    "channelHandle"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Tracks created successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Tracks created successfully"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/musics/tracks_by_playlist": {
            "post": {
                "tags": [
                    "Music"
                ],
                "summary": "Create tracks from YouTube playlist",
                "description": "Download and store tracks from a YouTube playlist by ID",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "playlistId": {
                                        "type": "string",
                                        "description": "YouTube playlist ID"
                                    }
                                },
                                "required": [
                                    "playlistId"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Tracks created successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Tracks created successfully"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid request",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string",
                                            "example": "playlistId is required"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/musics/tracks/{id}": {
            "get": {
                "tags": [
                    "Music"
                ],
                "summary": "Get a single track by ID",
                "description": "Retrieve details for a specific music track",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID of the track to retrieve",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "fields",
                        "in": "query",
                        "description": "Comma-separated list of fields to include in the response",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Track details",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "OK"
                                        },
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "id": {
                                                    "type": "string"
                                                },
                                                "snippet": {
                                                    "type": "object",
                                                    "properties": {
                                                        "title": {
                                                            "type": "string"
                                                        },
                                                        "channelTitle": {
                                                            "type": "string"
                                                        },
                                                        "thumbnails": {
                                                            "type": "object"
                                                        }
                                                    }
                                                },
                                                "streamUri": {
                                                    "type": "string"
                                                },
                                                "contentDetails": {
                                                    "type": "object"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Track not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string",
                                            "example": "Track with id abc123 not found"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/musics/tracks/{id}/next_track": {
            "get": {
                "tags": [
                    "Music"
                ],
                "summary": "Get the next track by creation date",
                "description": "Retrieve the next music track based on its creation date",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID of the current track",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Next track details",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "OK"
                                        },
                                        "data": {
                                            "$ref": "#/components/schemas/Track"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Track not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string",
                                            "example": "No next track found"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/musics/channels": {
            "get": {
                "tags": [
                    "Music"
                ],
                "summary": "Get all channels",
                "description": "Retrieve a paginated list of all unique channels with their ID and title",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Page number for pagination (default: 1)",
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "default": 1
                        }
                    },
                    {
                        "name": "limit",
                        "in": "query",
                        "description": "Number of items per page (default: 20)",
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "default": 20
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "List of channels",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "OK"
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/Channel"
                                            }
                                        },
                                        "pagination": {
                                            "type": "object",
                                            "properties": {
                                                "currentPage": {
                                                    "type": "integer",
                                                    "example": 1
                                                },
                                                "pageSize": {
                                                    "type": "integer",
                                                    "example": 10
                                                },
                                                "totalItems": {
                                                    "type": "integer",
                                                    "example": 25
                                                },
                                                "totalPages": {
                                                    "type": "integer",
                                                    "example": 3
                                                },
                                                "nextPage": {
                                                    "type": "integer",
                                                    "example": 2,
                                                    "description": "The next page number, or null if this is the last page"
                                                }
                                            },
                                            "required": [
                                                "currentPage",
                                                "pageSize",
                                                "totalItems",
                                                "totalPages"
                                            ]
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid request parameters",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Track": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "snippet": {
                        "type": "object",
                        "properties": {
                            "title": {
                                "type": "string"
                            },
                            "channelTitle": {
                                "type": "string"
                            },
                            "thumbnails": {
                                "type": "object",
                                "properties": {
                                    "standard": {
                                        "type": "object",
                                        "properties": {
                                            "url": {
                                                "type": "string"
                                            },
                                            "width": {
                                                "type": "integer"
                                            },
                                            "height": {
                                                "type": "integer"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "streamUri": {
                        "type": "string"
                    },
                    "contentDetails": {
                        "type": "object"
                    }
                }
            },
            "Channel": {
                "type": "object",
                "properties": {
                    "channelId": {
                        "type": "string",
                        "description": "Unique ID of the YouTube channel"
                    },
                    "channelTitle": {
                        "type": "string",
                        "description": "Name of the YouTube channel"
                    },
                    "trackCount": {
                        "type": "integer",
                        "description": "Number of tracks in the channel"
                    }
                },
                "required": [
                    "channelId",
                    "channelTitle"
                ]
            }
        }
    }
}